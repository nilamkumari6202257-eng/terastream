# ---- TeraBox (server-side only; never exposed to the browser) ----
# One or more ndus cookies, comma separated. First one is tried first; the rest are automatic fallbacks.
NDUS_TOKENS=your_ndus_token_1,your_ndus_token_2

# Admin panel password (server-checked). If you leave this out the password is "admin" - change it!
ADMIN_PASSWORD=change-me

# Optional
# PROXY_SECRET=long-random-string      # REQUIRED only if you run 2+ instances (same value on all). With one instance a secret is auto-generated and saved in DATA_DIR.
# DATA_DIR=./data                       # where admin data + tokens are saved (use a persistent disk on your host)
# PUBLIC_BASE_URL=https://yourdomain.com   # set if behind a proxy that hides the real host/https
# CORS_ORIGIN=https://yourdomain.com       # default is * (any site)
# PORT=8787

# ---- Frontend (only if the site and API are hosted on different domains) ----
# VITE_TERABOX_API_BASE=https://api.yourdomain.com/api/terabox
